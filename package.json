{
  "name": "accordion-lead-sheet-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run verify && wrangler deploy --dry-run --outdir dist-worker",
    "deploy": "wrangler deploy",
    "preview": "wrangler preview",
    "worker:dev": "wrangler dev --ip 127.0.0.1",
    "worker:types": "node -e \"require('node:fs').mkdirSync('.cloudflare/types', { recursive: true })\" && wrangler types .cloudflare/types/index.d.ts",
    "pages:build": "vite build",
    "pages:preview": "vite preview --host 127.0.0.1",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "oxlint --deny-warnings api src tests vite.config.ts vitest.config.ts",
    "typecheck": "npm run worker:types && tsc --noEmit && tsc --project api/tsconfig.json",
    "test": "vitest run",
    "test:live": "node --use-env-proxy node_modules/vitest/vitest.mjs run --mode live",
    "test:omr": "vitest run --mode omr",
    "verify": "npm run fmt:check && npm run lint && npm run typecheck && npm test",
    "audit:ui": "node tests/ui-audit/audit_runner.ts",
    "audit:stress": "node tests/ui-audit/challenger_stress_runner.ts",
    "audit:stress:m3": "node tests/ui-audit/challenger_m3_stress_runner.ts"
  },
  "devDependencies": {
    "@dprint/json": "0.21.3",
    "@dprint/typescript": "0.96.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dprint": "0.65.0",
    "happy-dom": "20.11.2",
    "jpeg-js": "0.4.4",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.164.0"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@xmldom/xmldom": "0.9.12",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.52.0",
    "onnxruntime-web": "1.30.0",
    "opensheetmusicdisplay": "2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  }
}
