# Deno validation commands need access to Deno's persistent origin storage and,
# for Vite/esbuild, paths outside the repository workspace. Keep approval
# interactive while requesting the command outside the sandbox up front.
prefix_rule(
  pattern = ["deno", "task", "test"],
  decision = "prompt",
  justification = "The hermetic test suite uses Deno localStorage persistence, which requires approved access to Deno's origin-storage directory.",
  match = [
    "deno task test",
  ],
  not_match = [
    "deno task test:live",
  ],
)
prefix_rule(
  pattern = ["deno", "task", "build"],
  decision = "prompt",
  justification = "The production Vite/esbuild build may need approved access beyond the repository workspace on Windows.",
  match = [
    "deno task build",
  ],
  not_match = [
    "deno task build:watch",
  ],
)
prefix_rule(
  pattern = ["deno", "task", "test:live"],
  decision = "prompt",
  justification = "Live parser tests access third-party sites and should remain explicitly approved.",
  match = [
    "deno task test:live",
  ],
)
prefix_rule(
  pattern = ["deno", "task", "audit:ui"],
  decision = "prompt",
  justification = "The UI audit may launch browser processes and access generated artifacts outside the normal test sandbox.",
  match = [
    "deno task audit:ui",
  ],
)
